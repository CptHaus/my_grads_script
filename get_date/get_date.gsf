function get_date(kind,format)

say 'kind = 'kind
if (kind != 'y' & kind != 'ym' & kind != 'ymd' & kind != 'ymdh' & kind != 'ymdhn')
    say 'Error: Wrong kind'
    exit
endif

say 'format = 'format
if (format != 1 & format != 2)
    say 'Error: Wrong format'
    exit
endif

'q time'
gdate = subwrd(result,3)
len = math_strlen(gdate)
if (len != 12 & len != 15)
    say 'Wrong length of GrADS date: 'gdate
    exit
endif

if (len = 12)
    yyyy = substr(gdate,9,4)
    mon  = substr(gdate,6,3)
    mm   = mon2mm(mon)
    dd   = substr(gdate,4,2)
    hh   = substr(gdate,1,2)
    nn   = '00'
    date1 = yyyy % '/' % mm % '/' % dd % ' ' % hh % ':00Z'
    date2 = yyyy % '-' % mm % '-' % dd % ' ' % hh % ':00Z'
else
    yyyy = substr(gdate,12,4)
    mon  = substr(gdate,9,3)
    mm   = mon2mm(mon)
    dd   = substr(gdate,7,2)
    hh   = substr(gdate,1,2)
    nn   = substr(gdate,4,2)
    date1 = yyyy % '/' % mm % '/' % dd % ' ' % hh % ':' % nn % 'Z'
    date2 = yyyy % '-' % mm % '-' % dd % ' ' % hh % ':' % nn % 'Z'
endif

if (format = 1)
  date = date1
else
  date = date2
endif

if (kind = 'y') ; date = substr(date,1,4) ; endif
if (kind = 'ym') ; date = substr(date,1,7) ; endif
if (kind = 'ymd') ; date = substr(date,1,10) ; endif
if (kind = 'ymdh')
    date = substr(date,1,13)
    date = date % 'Z'
endif
if (kind = 'ymdhn') ; date = substr(date,1,17) ; endif

say 'get_date: 'gdate' ---> 'date

return date
